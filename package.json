{
  "name": "spar-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:gh": "VITE_BASE_PATH=/Sparring-Rounds-Timer/ vue-tsc -b && VITE_BASE_PATH=/Sparring-Rounds-Timer/ vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --pretty false",
    "deploy:gh": "npm run build:gh && npx gh-pages -d dist -m \"Deploy Spar Timer to GitHub Pages\""
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.2.7",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "workbox-window": "^7.4.1"
  }
}
